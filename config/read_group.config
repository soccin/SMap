/*
 * -------------------------------------------------
 * Read group: swap SM and LB at alignment time
 * -------------------------------------------------
 * Included by iris.config and neo.config.
 *
 * Sarek builds the read group it passes to `bwa mem -R` as
 *
 *   @RG  ID:<id>  PU:<lane>  SM:<patient>_<sample>  LB:<sample>  DS:..  PL:..
 *
 * (sarek/workflows/sarek/main.nf and
 * sarek/subworkflows/local/samplesheet_to_channel/main.nf). SMap BAMs are
 * the input to our own variant calling pipeline, which needs SM to be the
 * sample name. So this file swaps the SM and LB tag names in that string:
 *
 *   @RG  ID:<id>  PU:<lane>  SM:<sample>  LB:<patient>_<sample>  DS:..  PL:..
 *
 * The tags are right from the first BAM BWA writes, so md.bam and
 * recal.bam are both correct. No reheader, no extra BAM copy.
 *
 * Before 4.0.0 the same swap was applied to the CRAM header afterwards by
 * sarekCramToBam.sh and fix_sarek_headers.py, now retired to bin/attic/.
 * Do NOT run them on BAMs made with this config: they would swap the tags
 * back.
 *
 * Why the rest of mapping is unaffected:
 * - MarkDuplicates groups reads into libraries by LB. LB is still one value
 *   per sample, the same across all its lanes, so duplicate marking does
 *   not change.
 * - BQSR groups reads by read group (ID/PU); neither changes.
 *
 * Consequence: Sarek's own variant callers (Mutect2, Sentieon TNscope)
 * expect the normal to be named <patient>_<sample>, so these BAMs cannot be
 * fed back into Sarek variant calling. SMap does not use it.
 *
 * The ext.args below is Sarek's BWA ext.args (sarek/conf/modules/
 * aligner.config, same selector string) with only the read group changed.
 * Using Sarek's exact selector replaces its setting instead of adding a
 * second one that competes with it. Re-check against aligner.config on
 * every Sarek update, and run the test: tests/read_group/run.sh
 *
 * If Sarek changes the read group so there is no single SM/LB pair to
 * swap, the run stops with an error instead of writing mislabeled BAMs.
 */

process {

  withName: 'BWAMEM.*_MEM|SENTIEON_BWAMEM' {
    ext.args = {
      // meta.read_group is one string with the fields joined by a literal
      // backslash-t (two characters); bwa turns \t into a tab
      def fields = meta.read_group.split(/\\t/) as List
      def swapped = fields.collect { field ->
        field.startsWith('SM:') ? 'LB:' + field.substring(3) :
        field.startsWith('LB:') ? 'SM:' + field.substring(3) :
        field
      }
      def nChanged = (0..<fields.size()).count { fields[it] != swapped[it] }
      if (nChanged != 2) {
        throw new IllegalStateException(
          "SMap read_group.config: expected one SM: and one LB: field to swap, " +
          "found ${nChanged} in ${meta.read_group}")
      }
      def read_group = swapped.join('\\t')

      // Same as Sarek, including -B 3 for tumor samples
      meta.status == 1 ?
        "-K 100000000 -Y -B 3 -R ${read_group}" :
        "-K 100000000 -Y -R ${read_group}"
    }
  }

}

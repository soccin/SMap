// Local run for tests/read_group. The Singularity cache comes from
// NXF_SINGULARITY_CACHEDIR, which run.sh sets per cluster.

singularity {
  enabled    = true
  autoMounts = true
}

process {
  executor = 'local'
  cpus     = 1

  // Same retry-then-ignore strategy as iris.config and neo.config, so the
  // bad case proves a read group error stops the run instead of being
  // retried and then ignored
  maxRetries    = 3
  errorStrategy = { task.attempt <= process.maxRetries ? 'retry' : 'ignore' }
}
